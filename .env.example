# Local development only. Copy to .env and change these values.
MS1_DB_NAME=unilearn_courses
MS1_DB_USER=unilearn_ms1
MS1_DB_PASSWORD=change-me-ms1-local
MYSQL_ROOT_PASSWORD=change-me-root-local
MS1_MYSQL_PORT=3306

# MS6 PostgreSQL (local development only; replace the placeholder locally)
MS6_DB_NAME=unilearn_ms6
MS6_DB_USER=unilearn_ms6
MS6_DB_PASSWORD=change-me-ms6-local
MS6_DB_HOST=localhost
MS6_DB_PORT=5433
MS6_POSTGRES_PORT=5433
MS6_API_PORT=8086
# Local Keycloak dev service; change these credentials before sharing the environment.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-local
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_HOSTNAME=http://localhost:8180
MS6_KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/unilearn
MS6_MS1_COURSES_URL=http://localhost:8081/api/courses
# Optional OpenAI-compatible chatbot endpoint (uncomment and configure)
# MS6_LLM_BASE_URL=https://your-provider.example/v1
# MS6_LLM_API_KEY=replace-with-local-secret
# MS6_LLM_MODEL=your-chat-model
MS6_LLM_TIMEOUT_SECONDS=20
# Heuristic risk policy; tune to the institution before use
MS6_RISK_LOW_SCORE_THRESHOLD=50
MS6_RISK_SCORE_DECLINE_THRESHOLD=15
MS6_RISK_COMPLETION_THRESHOLD=0.6
MS6_RISK_MODERATE_SCORE=30
MS6_RISK_HIGH_SCORE=60
