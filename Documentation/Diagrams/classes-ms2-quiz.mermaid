classDiagram
  class Quiz { +Long id; +String title; +String courseId }
  class Question { +Long id; +String text; +String correctOption }
  class Option { +Long id; +String label }
  class Attempt { +Long id; +String userId; +int score; +Date date }
  Quiz "1" --> "many" Question
  Question "1" --> "many" Option
  Quiz "1" --> "many" Attempt
