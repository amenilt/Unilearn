flowchart LR
  E([Étudiant])
  P([Enseignant])
  A([Administrateur])
  E --> U1(Consulter les cours)
  E --> U2(Passer un quiz)
  E --> U3(Déposer et suivre une réclamation)
  E --> U4(Poser et répondre sur le forum)
  E --> U5(Participer à un duel)
  E --> U6(Gagner des badges)
  P --> V1(Publier un cours)
  P --> V2(Créer un quiz)
  P --> V3(Traiter une réclamation)
  P --> V4(Modérer le forum)
  A --> W1(Gérer utilisateurs et rôles)
  A --> W2(Gérer les badges)
  A --> W3(Superviser la plateforme)
