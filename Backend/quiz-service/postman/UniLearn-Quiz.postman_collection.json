{
  "info": {
    "_postman_id": "f882c5c6-8935-4db8-a597-dceea469d304",
    "name": "UniLearn MS2 Quiz",
    "description": "Exemples CRUD, soumission, erreurs et Actuator pour le microservice Quiz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "quizId", "value": "1" }
  ],
  "item": [
    {
      "name": "Quiz CRUD",
      "item": [
        {
          "name": "Créer un quiz",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"courseId\":1,\"title\":\"Quiz Postman\",\"duration\":20,\"questions\":[{\"text\":\"Quelle annotation expose REST ?\",\"points\":2,\"options\":[{\"text\":\"@RestController\",\"correct\":true},{\"text\":\"@Entity\",\"correct\":false}]}]}"
            },
            "url": "{{baseUrl}}/api/quizzes"
          }
        },
        {
          "name": "Lister les quiz",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes" }
        },
        {
          "name": "Filtrer par cours",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes?courseId=1" }
        },
        {
          "name": "Lire un quiz",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes/{{quizId}}" }
        },
        {
          "name": "Modifier un quiz",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"courseId\":1,\"title\":\"Quiz modifié\",\"duration\":15,\"questions\":[{\"text\":\"2+2 ?\",\"points\":1,\"options\":[{\"text\":\"4\",\"correct\":true},{\"text\":\"5\",\"correct\":false}]}]}"
            },
            "url": "{{baseUrl}}/api/quizzes/{{quizId}}"
          }
        },
        {
          "name": "Ajouter une question",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Question ajoutée ?\",\"points\":1,\"options\":[{\"text\":\"Oui\",\"correct\":true},{\"text\":\"Non\",\"correct\":false}]}"
            },
            "url": "{{baseUrl}}/api/quizzes/{{quizId}}/questions"
          }
        },
        {
          "name": "Supprimer un quiz",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/quizzes/{{quizId}}" }
        }
      ]
    },
    {
      "name": "Tentatives",
      "item": [
        {
          "name": "Soumettre une tentative",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"studentId\":\"student-demo-1\",\"answers\":[{\"questionId\":1,\"optionId\":1}]}"
            },
            "url": "{{baseUrl}}/api/quizzes/{{quizId}}/submit"
          }
        },
        {
          "name": "Résultats",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes/{{quizId}}/results" }
        },
        {
          "name": "Instance info",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes/instance-info" }
        }
      ]
    },
    {
      "name": "Actuator",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" } },
        { "name": "Info", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/info" } },
        { "name": "Metrics", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/metrics" } },
        { "name": "HTTP requests metric", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/metrics/http.server.requests" } },
        { "name": "Prometheus", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/prometheus" } },
        { "name": "Mappings", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/mappings" } },
        { "name": "Environment", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/env" } },
        { "name": "Beans", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/beans" } },
        { "name": "Loggers", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/loggers" } }
      ]
    }
  ]
}
